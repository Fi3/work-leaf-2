  "audio": false,
  "steps": [
    {
      "seconds": 0.0,
      "text": "Start ./harness.sh in your project. This is an isolated test with synthetic account replies."
    },
    {
      "seconds": 2.2,
      "text": "Press ;. The left tree lists agents for this directory. Press n to create a chat."
    },
    {
      "seconds": 6.6,
      "text": "Type \\login and press Enter. Search or scroll through all 42 provider choices."
    },
    {
      "seconds": 10.8,
      "text": "Escape returns to the chat. Type \\login openai to choose OpenAI directly."
    },
    {
      "seconds": 13.0,
      "text": "Select Sign in with ChatGPT. Pi opens the browser login. This test supplies a local callback and synthetic tokens."
    },
    {
      "seconds": 18.8,
      "text": "Login opens that provider\u2019s models. For this recording, use the local demo to avoid a paid model request."
    },
    {
      "seconds": 24.2,
      "text": "Name the chat with \\name Review. Write a task; Shift-Enter adds a line."
    },
    {
      "seconds": 27.4,
      "text": "Enter sends. The actual Rust server and Pi worker run the Bash tool and stream the reply."
    },
    {
      "seconds": 32.3,
      "text": "Press Escape, then ; twice and r. Tests is nested below its creator."
    },
    {
      "seconds": 34.5,
      "text": "Select Tests with Enter. Its conversation and draft are separate. Ctrl-^ returns to the previous chat."
    },
    {
      "seconds": 37.8,
      "text": "Open NERDTree. Select app.py and press s for the normal vertical file split."
    },
    {
      "seconds": 42.1,
      "text": "Ctrl-W L selects the chat. Its message box appears only below that chat; the file keeps its full height."
    },
    {
      "seconds": 45.3,
      "text": "NERDTree Enter opens app.py in the current file area. The chat and its message box are hidden."
    },
    {
      "seconds": 48.6,
      "text": "Ctrl-^ restores the chat and its message box. Stored history remains available."
    },
    {
      "seconds": 51.0,
      "text": "NERDTree i opens README.txt in a normal horizontal split."
    },
    {
      "seconds": 55.3,
      "text": "Use :q to close the file split. Use :qa to close the idle editor. All chats stay saved."
    }
  ],
  "assertions": [
    "one normal editor window before semicolon",
    "new chat opens immediately with input in Insert mode",
    "login catalog includes all 42 providers with account or key methods",
    "OpenAI account login runs in immediate terminal mode and completes a local callback",
    "login opens provider models; all-provider model picker scrolls",
    "local demo selection permits a fixed reproducible task without a paid request",
    "Shift-Enter adds a line and Enter sends the prompt",
    "actual Bash creates a stored child; the tree nests it under its parent",
    "child history is separate and Ctrl-^ returns to the previous chat",
    "NERDTree s opens a normal vertical split with readable file and chat widths",
    "file focus hides the message box; chat focus restores it only under its own chat",
    "NERDTree Enter replaces the current chat with a file; Ctrl-^ restores chat",
    "NERDTree i opens a normal horizontal split",
    "q closes a file split; qa closes the idle editor",
    "chat settings do not create a global configuration file"
  ],
  "cleanup": "Private server stopped; terminal and Xvfb closed; no test task in user sessions",
