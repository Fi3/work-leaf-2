  "steps": [
    {
      "seconds": 0.0,
      "text": "Actual Neovim, Rust and Pi. OpenAI responses are synthetic in this repeatable account recovery test."
    },
    {
      "seconds": 3.2,
      "text": "Create a chat. Select OpenAI gpt-6-sol with a chat command."
    },
    {
      "seconds": 3.9,
      "text": "Send a task with Enter, then write the next draft. Input must stay in Insert mode."
    },
    {
      "seconds": 7.5,
      "text": "The error gives an account action. Replace the unsent draft with \\login openai to connect another account."
    },
    {
      "seconds": 10.0,
      "text": "Sign in with ChatGPT uses Pi login. This test supplies synthetic tokens through the local callback."
    },
    {
      "seconds": 13.4,
      "text": "Send again. The saved account replaces the environment key. The real OpenAI SDK reads streamed tool calls."
    },
    {
      "seconds": 18.0,
      "text": "Write another draft. Open app.py through NERDTree with Enter. The message box closes in file mode."
    },
    {
      "seconds": 21.2,
      "text": "Ctrl-^ returns to the chat. The answer and draft remain. Close the idle editor with :qa."
    }
  ],
  "checks": [
